# =============================================================
# Nexus CX Intelligence Platform -- .gitignore
# Node.js + Express + SQLite project
# =============================================================

# Dependencies
node_modules/

# Environment and secrets
.env
.env.local
.env.*.local

# SQLite databases (runtime data, not source)
*.db
*.db-journal
*.db-wal
*.db-shm

# Runtime data directory (benchmark reports, traffic reports, embeddings cache)
data/

# Logs
*.log
logs/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Test output and coverage
coverage/
.nyc_output/
test-results/

# Build artifacts
dist/
build/
out/

# Temporary files
tmp/
temp/
*.tmp

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
