# Nexus CX Intelligence Platform — Environment Variables
# Copy to .env and modify as needed. All values shown are defaults.

# Server
CX_PORT=3143

# Ollama (local LLM inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=nemotron-mini
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=15000
OLLAMA_EMBED_TIMEOUT_MS=10000

# Persistence (SQLite)
PERSIST=true
DATA_DIR=./data

# Logging
LOG_LEVEL=info

# Event Fabric
FABRIC_STREAM_SIZE=10000

# Analytics
METRICS_SERIES_SIZE=10000
ANALYSIS_STORE_MAX=500

# Journey Engine
JOURNEY_HISTORY_MAX=10000

# NBA Engine
NBA_ACTION_LOG_MAX=5000

# Identity
SESSION_TTL_MS=86400000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
